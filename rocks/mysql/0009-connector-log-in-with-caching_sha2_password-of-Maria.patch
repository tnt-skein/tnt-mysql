From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Khovanskiy <a@khovanskiy.ru>
Date: Sun, 27 Sep 2026 13:00:00 +0300
Subject: [PATCH 9/9] connector: log in with caching_sha2_password of MariaDB
 Connector/C 3.4.10

The connector in the submodule, tarantool/mariadb-connector-c at
54cdb25, is MariaDB Connector/C 3.0.2 with an io wait callback. It
knows no caching_sha2_password, the default authentication of MySQL 8
and 9, while mysql_native_password is off by default in MySQL 8.4 and
gone in MySQL 9. A login to such a server fails with 'Plugin
caching_sha2_password could not be loaded'.

MariaDB Connector/C has both now: the io wait callback as
MARIADB_OPT_IO_WAIT since 3.1.0 (CONC-377) and caching_sha2_password
since 3.0.8 (CONC-312). The submodule moves to the upstream repository
at v3.4.10, and the driver sets its callback by the upstream name.

mysql_stmt_bind_result of 3.4.10 resets the length of a string value,
and the driver bound the grown buffers of a prepared statement before
it read the row: a value fetched whole with mysql_stmt_fetch_column
came empty, and 100 of a recursive CTE counting to 200 came as 0. The
grown buffers are bound once the row is read.

caching_sha2_password is linked into the driver: a dynamic plugin is
looked for in the plugin directory of an installed connector, which a
rock does not have. It needs OpenSSL for SHA-256 and for the RSA
exchange of the password, which a login without TLS does when the
server has no cached hash of it. Built with a TLS library, the
connector demands TLS with a verified server certificate by default,
while the driver sets no TLS options: DEFAULT_SSL_VERIFY_SERVER_CERT
is off, and a connection stays plain as before.

3.4.10 also has what the old connector needed on top: it builds with
CMake 4 and a recent clang, and a row with a truncated value is
fetched, so mysql_stmt_fetch_column reads the rest of the value.
---
 .gitmodules         |  2 +-
 CMakeLists.txt      | 20 ++++++++++++++++++++
 mariadb-connector-c |  2 +-
 mysql/driver.c      | 21 ++++++++++++++++-----
 4 files changed, 38 insertions(+), 7 deletions(-)

diff --git a/.gitmodules b/.gitmodules
index 0519d03..b2dd88d 100644
--- a/.gitmodules
+++ b/.gitmodules
@@ -1,3 +1,3 @@
 [submodule "mariadb-connector-c"]
 	path = mariadb-connector-c
-	url = https://github.com/tarantool/mariadb-connector-c
+	url = https://github.com/mariadb-corporation/mariadb-connector-c
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 93d0892..f132ccd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -34,6 +34,26 @@ if (EXISTS "${CMAKE_SOURCE_DIR}/.git" AND GIT)
     endif()
 endif()
 
+# caching_sha2_password is the default authentication of MySQL 8.4 and
+# 9, and MySQL 9 has no mysql_native_password. A dynamic plugin is
+# looked for in the plugin directory of an installed connector, which a
+# rock does not have, so the plugin is linked into the driver. It needs
+# OpenSSL: for SHA-256 and for the RSA exchange of the password on a
+# connection without TLS.
+find_package(OpenSSL REQUIRED)
+set(WITH_SSL OPENSSL)
+set(CLIENT_PLUGIN_CACHING_SHA2_PASSWORD STATIC)
+# The driver sets no TLS options. Built with a TLS library, the
+# connector would demand TLS with a verified certificate from every
+# server otherwise, and fail on a server without TLS or with the
+# self-signed certificate MySQL creates.
+set(DEFAULT_SSL_VERIFY_SERVER_CERT OFF)
+# A subproject is told where to install its dynamic plugins by the
+# MariaDB server tree, and without that the connector fails to
+# configure. The driver builds none of them, so nothing goes there.
+set(INSTALL_PLUGINDIR lib/mariadb/plugin)
+# The tests of the connector are not a part of the driver.
+set(WITH_UNIT_TESTS OFF)
 add_subdirectory(mariadb-connector-c EXCLUDE_FROM_ALL)
 
 include_directories("${CMAKE_SOURCE_DIR}/mariadb-connector-c/include" "${CMAKE_BINARY_DIR}/mariadb-connector-c/include")
diff --git a/mariadb-connector-c b/mariadb-connector-c
index 54cdb25..8153da4 160000
--- a/mariadb-connector-c
+++ b/mariadb-connector-c
@@ -1 +1 @@
-Subproject commit 54cdb253643aaf185ef84ff9bb58c6b2fde990a3
+Subproject commit 8153da40fe720b1d25db12aa3f993918da15bd3b
diff --git a/mysql/driver.c b/mysql/driver.c
index e473c38..6e717eb 100755
--- a/mysql/driver.c
+++ b/mysql/driver.c
@@ -503,8 +503,9 @@ lua_mysql_stmt_push_row(struct lua_State *L)
 
 /*
  * Fetch again the values of the current row that did not fit their
- * buffers: grow each such buffer to the length of its value, fetch
- * the value whole and bind the grown buffers for the next rows.
+ * buffers: grow each such buffer to the length of its value and fetch
+ * the value whole. The caller binds the grown buffers for the next
+ * rows once the row is read.
  *
  * Returns 0 on success, 1 on an error of the statement and -1 if
  * there is no memory for a buffer.
@@ -526,7 +527,7 @@ lua_mysql_stmt_fetch_long(MYSQL_STMT *stmt, MYSQL_BIND *binds,
 		if (mysql_stmt_fetch_column(stmt, bind, col_no, 0) != 0)
 			return 1;
 	}
-	return mysql_stmt_bind_result(stmt, binds) != 0;
+	return 0;
 }
 
 /*
@@ -649,7 +650,8 @@ lua_mysql_execute_prepared(struct lua_State *L)
 		 * A value longer than its buffer used to end the result
 		 * silently: 99 rows of 200 came without an error.
 		 */
-		if (fetched == MYSQL_DATA_TRUNCATED)
+		int grown = fetched == MYSQL_DATA_TRUNCATED;
+		if (grown)
 			fetched = lua_mysql_stmt_fetch_long(stmt, result_binds,
 							    col_count);
 		/*
@@ -670,6 +672,15 @@ lua_mysql_execute_prepared(struct lua_State *L)
 			goto done;
 		lua_settable(L, -3);
 		++row_idx;
+		/*
+		 * The grown buffers serve the next rows. They are bound
+		 * once the row is read: binding resets the length of a
+		 * string value, and a value fetched whole would come
+		 * empty.
+		 */
+		if (grown && (error = mysql_stmt_bind_result(stmt,
+							     result_binds)))
+			goto done;
 	}
 	lua_settable(L, -3);
 
@@ -827,7 +838,7 @@ lua_mysql_connect(struct lua_State *L)
 		iport = atoi(port); /* 0 is ok */
 	}
 
-	mysql_options(tmp_raw_conn, MYSQL_OPT_IO_WAIT, mysql_wait_for_io);
+	mysql_options(tmp_raw_conn, MARIADB_OPT_IO_WAIT, mysql_wait_for_io);
 
 	raw_conn = mysql_real_connect(tmp_raw_conn, host, user, pass,
 		db, iport, usocket,
-- 

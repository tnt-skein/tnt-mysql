From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Khovanskiy <a@khovanskiy.ru>
Date: Sat, 19 Sep 2026 13:00:00 +0300
Subject: [PATCH 7/7] driver: refuse a statement with fewer values than
 parameters

A missing value of a prepared statement was taken from the stack of
the driver: the check compared the parameter index with the top of the
stack, which held the status and the result table pushed before, and
'select ? as a, ? as b' with one value returned {a = 1, b = 0}. The
values are counted before anything is pushed now, and fewer values than
parameters is an error CR_PARAMS_NOT_BOUND (2031). Extra values are
ignored, as before.
---
 mysql/driver.c | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/mysql/driver.c b/mysql/driver.c
index 0b2276c..a500200 100755
--- a/mysql/driver.c
+++ b/mysql/driver.c
@@ -29,6 +29,7 @@
 #include <module.h>
 
 #include <stddef.h>
+#include <stdio.h>
 #include <assert.h>
 #include <stdlib.h>
 #include <string.h>
@@ -511,6 +512,8 @@ lua_mysql_execute_prepared(struct lua_State *L)
 	struct mysql_connection *conn = lua_check_mysqlconn(L, 1);
 	size_t len;
 	const char *sql = lua_tolstring(L, 2, &len);
+	/* The values follow the connection and the text. */
+	unsigned long value_count = (unsigned long) lua_gettop(L) - 2;
 	int ret_count = 0, fail = 0, error = 0;
 	my_ulonglong affected = (my_ulonglong) ~0;
 	my_ulonglong insert_id = 0;
@@ -536,15 +539,26 @@ lua_mysql_execute_prepared(struct lua_State *L)
 		goto done;
 	/* Alloc space for input parameters */
 	unsigned long paramCount = mysql_stmt_param_count(stmt);
+	/*
+	 * A missing value used to be taken from the stack of the
+	 * driver: the check below counted the status and the result
+	 * table pushed above, and 'select ? as a, ? as b' with one
+	 * value returned {a = 1, b = 0}.
+	 */
+	if (value_count < paramCount) {
+		char message[128];
+		snprintf(message, sizeof(message), "The statement has %lu "
+			 "parameters, but %lu values are given", paramCount,
+			 value_count);
+		ret_count = lua_mysql_push_error_of(L, CR_PARAMS_NOT_BOUND,
+						    message);
+		goto done;
+	}
 	param_binds = (MYSQL_BIND *)calloc(sizeof(*param_binds), paramCount);
 	values = (uint64_t *)calloc(sizeof(*values), paramCount);
 	/* Setup input bind buffer */
 	unsigned param_no;
 	for (param_no = 0; param_no < paramCount; ++param_no) {
-		if ((unsigned long)lua_gettop(L) <= param_no + 3) {
-			param_binds[param_no].buffer_type = MYSQL_TYPE_NULL;
-			continue;
-		}
 		switch (lua_type(L, 3 + param_no)) {
 		case LUA_TNIL:
 			param_binds[param_no].buffer_type = MYSQL_TYPE_NULL;
